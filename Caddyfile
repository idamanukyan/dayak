# Auto-TLS reverse proxy. Set DAYAK_DOMAIN in the environment (e.g. app.dayak.am).
# Caddy obtains + renews Let's Encrypt certificates automatically.
{$DAYAK_DOMAIN} {
	encode zstd gzip

	# Security headers are also set by Next; these are defence-in-depth at the edge.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy web:3000
}
