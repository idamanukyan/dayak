# Copy to .env (root, for Prisma/Docker) and apps/web/.env.local (for Next.js).
# See docs/RUNBOOK.md.

# --- Database / infra ---
DATABASE_URL=postgresql://dayak:dayak@localhost:5432/dayak
REDIS_URL=redis://localhost:6379

# --- Auth.js ---
AUTH_SECRET=                     # openssl rand -base64 32
# Optional Google OAuth (app runs without it; credentials login always works)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- S3 / MinIO (dev) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=dayak-private
S3_ACCESS_KEY=dayak
S3_SECRET_KEY=dayakminio
S3_REGION=auto

# --- Anthropic (Phase 2+) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Force the offline scripted interviewer even when a key is set (dev/tests):
# DAYAK_AI_MOCK=1

# --- Langfuse (Phase 2+, optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Email (Phase 5) ---
RESEND_API_KEY=
EMAIL_FROM="Dayak <hello@dayak.am>"

# --- Telegram (Phase 5) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
INTERNAL_API_SECRET=

# --- Web ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json
